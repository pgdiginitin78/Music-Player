  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9160023677795757" crossorigin="anonymous"></script>

  <style>
    /* ===== Sidebar navigation visibility (desktop only) ===== */
    @media (max-width:991px){
      .sidebar{display:none}
      .main_content{margin-left:0 !important}
    }
    @media (min-width:992px){
      .main_content{margin-left:250px !important}
    }

    /* ===== Download-page specific (light, vsthemes-inspired) ===== */
    .dl-wrap{padding:24px 0 50px;animation:fadeInUp .5s ease-out}
    .dl-title{font-size:30px;font-weight:700;color:#131313;letter-spacing:-.01em;line-height:1.2;margin:0 0 22px;padding:0 4px}

    .dl-banner-ad{margin:0 0 22px;text-align:center;min-height:1px}
    .dl-banner-ad ins{margin:0 auto}

    .dl-card{background:#fff;border:1px solid #ededed;border-radius:14px;box-shadow:0 1px 3px rgba(0,0,0,.04);overflow:hidden;margin-bottom:22px}

    /* Download row (vsthemes-style) */
    .dl-row{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 22px;border-bottom:1px solid #f3f4f6;transition:.2s}
    .dl-row:last-child{border-bottom:none}
    .dl-row:hover{background:#fafbfc}
    .dl-row-left{display:flex;align-items:center;gap:14px;min-width:0;flex:1}
    .dl-icon{width:42px;height:42px;border-radius:50%;background:#f1f5f9;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#307df0}
    .dl-icon svg{width:22px;height:22px}
    .dl-label{font-size:15px;font-weight:600;color:#131313;line-height:1.35;word-break:break-word}
    .dl-sub{font-size:13px;color:#64748b;margin-top:2px}
    .dl-eta{font-size:13px;font-weight:600;color:#f59e0b;white-space:nowrap}
    .dl-eta.ready{color:#10b981}

    .dl-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 22px;font-size:14px;font-weight:600;color:#fff;background:#307df0;border:none;border-radius:999px;text-decoration:none;cursor:pointer;transition:.2s;white-space:nowrap;box-shadow:0 2px 8px rgba(48,125,240,.25)}
    .dl-btn:hover{background:#1d4ed8;transform:translateY(-1px);box-shadow:0 4px 14px rgba(48,125,240,.35)}
    .dl-btn.disabled{background:#fce4d6;color:#fb923c;cursor:not-allowed;box-shadow:none;pointer-events:none}
    .dl-btn svg{width:16px;height:16px}

    /* Progress bar inline */
    .dl-progress-row{padding:0 22px 18px}
    .dl-progress{width:100%;height:4px;background:#f1f5f9;border-radius:999px;overflow:hidden}
    .dl-progress-fill{height:100%;width:0%;background:linear-gradient(90deg,#307df0,#60a5fa);border-radius:999px;transition:width 1s linear}

    /* File metadata panel */
    .dl-meta{background:#f8fafc;border:1px solid #ededed;border-radius:12px;padding:6px 22px;margin-bottom:22px}
    .dl-meta-row{display:flex;align-items:center;gap:16px;padding:14px 0;border-bottom:1px solid #ededed;font-size:14px}
    .dl-meta-row:last-child{border-bottom:none}
    .dl-meta-key{flex:0 0 130px;color:#64748b;font-weight:500}
    .dl-meta-val{color:#131313;font-weight:600;word-break:break-word;min-width:0}
    .dl-meta-val a{color:#307df0;text-decoration:none}
    .dl-meta-val a:hover{text-decoration:underline}

    /* How-to tutorial panel */
    .dl-howto{background:#fff;border:1px solid #ededed;border-radius:14px;padding:24px 26px;margin-bottom:22px}
    .dl-howto-head{display:flex;align-items:center;gap:12px;margin-bottom:6px}
    .dl-howto-badge{width:38px;height:38px;border-radius:10px;background:#eef4ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#307df0}
    .dl-howto-badge svg{width:22px;height:22px}
    .dl-howto-title{font-size:18px;font-weight:700;color:#131313;margin:0}
    .dl-howto-sub{font-size:14px;color:#64748b;margin:0 0 20px;line-height:1.6}
    .dl-howto-steps{list-style:none;counter-reset:h;padding:0;margin:0 0 20px}
    .dl-howto-steps li{counter-increment:h;padding:0 0 20px 46px;position:relative;color:#475569;font-size:14px;line-height:1.6}
    .dl-howto-steps li:last-child{padding-bottom:0}
    .dl-howto-steps li::before{content:counter(h);position:absolute;left:0;top:-2px;width:30px;height:30px;background:#307df0;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;z-index:1}
    .dl-howto-steps li:not(:last-child)::after{content:'';position:absolute;left:14px;top:30px;bottom:8px;width:2px;background:#e9eef5}
    .dl-howto-steps strong{color:#131313;font-weight:600}
    .dl-howto-label{font-size:13px;font-weight:600;color:#131313;margin:4px 0 10px}
    .dl-howto-stores{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:18px}
    .dl-store{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;font-size:14px;font-weight:600;color:#131313;background:#fff;border:1px solid #e2e8f0;border-radius:10px;text-decoration:none;transition:.2s}
    .dl-store:hover{border-color:#307df0;background:#f8fbff;transform:translateY(-1px)}
    .dl-store svg{width:20px;height:20px;flex-shrink:0}
    .dl-howto-video{display:flex;align-items:center;gap:11px;font-size:14px;font-weight:600;color:#131313;text-decoration:none;padding:16px 0 0;margin-top:4px;border:0;border-top:1px solid #f1f1f3;width:100%;background:none;cursor:pointer;font-family:inherit;text-align:left}
    .dl-howto-video:hover{color:#307df0}
    .dl-play{width:36px;height:36px;background:#dc2626;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;transition:.2s}
    .dl-howto-video:hover .dl-play{background:#b91c1c}
    .dl-play svg{width:15px;height:15px;color:#fff}
    .dl-howto-video small{display:block;font-size:12px;font-weight:400;color:#94a3b8;margin-top:2px}

    /* Video tutorial modal */
    .dl-vmodal{display:none;position:fixed;inset:0;background:rgba(15,23,42,.82);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);justify-content:center;align-items:center;z-index:10000;padding:24px;animation:fadeIn .25s ease-out}
    .dl-vmodal.open{display:flex}
    .dl-vmodal-box{width:100%;max-width:880px;position:relative;animation:slideUp .3s ease-out}
    .dl-vmodal-close{position:absolute;top:-46px;right:0;width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.16);border:none;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.2s}
    .dl-vmodal-close:hover{background:rgba(255,255,255,.32)}
    .dl-vmodal-frame{position:relative;width:100%;padding-bottom:56.25%;height:0;border-radius:14px;overflow:hidden;background:#000;box-shadow:0 24px 70px rgba(0,0,0,.55)}
    .dl-vmodal-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
    @media (max-width:640px){
      .dl-vmodal-close{top:-42px;width:34px;height:34px}
    }

    /* Back to publication */
    .dl-back-row{text-align:center;margin:6px 0 22px}
    .dl-back-big{display:inline-flex;align-items:center;gap:10px;padding:14px 30px;font-size:15px;font-weight:600;color:#fff;background:#131313;border:none;border-radius:999px;text-decoration:none;cursor:pointer;transition:.2s;box-shadow:0 4px 14px rgba(19,19,19,.18)}
    .dl-back-big:hover{background:#307df0;transform:translateY(-1px);box-shadow:0 6px 20px rgba(48,125,240,.32)}
    .dl-back-big svg{width:18px;height:18px}

    /* Notes */
    .dl-note{color:#64748b;font-size:13px;line-height:1.65;padding:0 4px;margin-bottom:14px}
    .dl-note a{color:#307df0;text-decoration:none}
    .dl-note a:hover{text-decoration:underline}

    /* AdBlock alert */
    .dl-alert{background:linear-gradient(135deg,#fff7ed 0%,#fef2f2 100%);border:1px solid #fed7aa;border-radius:12px;padding:22px;text-align:center;margin-bottom:22px}
    .dl-alert h3{font-size:17px;margin-bottom:8px;color:#9a3412;font-weight:700}
    .dl-alert p{font-size:14px;margin-bottom:16px;color:#9a3412;opacity:.9}
    .dl-alert-btn{padding:10px 24px;font-size:14px;font-weight:600;color:#fff;background:#ea580c;border:none;border-radius:8px;cursor:pointer;transition:.2s}
    .dl-alert-btn:hover{background:#c2410c}

    /* Cooldown alert */
    .dl-cooldown{background:linear-gradient(135deg,#eff6ff 0%,#f0f9ff 100%);border:1px solid #bfdbfe;border-radius:14px;padding:30px 24px;text-align:center;margin-bottom:22px}
    .dl-cooldown-icon{width:56px;height:56px;border-radius:50%;background:#fff;border:1px solid #bfdbfe;margin:0 auto 14px;display:flex;align-items:center;justify-content:center;color:#307df0}
    .dl-cooldown-icon svg{width:28px;height:28px}
    .dl-cooldown h3{font-size:19px;font-weight:700;color:#131313;margin:0 0 8px}
    .dl-cooldown p{font-size:14px;color:#475569;margin:0 0 18px;line-height:1.55}
    .dl-cooldown p strong{color:#131313}
    #dlCooldownLeft{font-weight:700;color:#307df0;font-variant-numeric:tabular-nums}
    .dl-cooldown-btn{display:inline-flex;align-items:center;gap:8px;padding:11px 24px;font-size:14px;font-weight:600;color:#fff;background:#131313;border:none;border-radius:999px;text-decoration:none;cursor:pointer;transition:.2s}
    .dl-cooldown-btn:hover{background:#307df0;transform:translateY(-1px)}

    /* Header back-btn (right_side) */
    .dl-header-back{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:500;color:#64748b;background:#f6f6f6;border:1px solid #ededed;padding:9px 16px;border-radius:10px;text-decoration:none;transition:.2s}
    .dl-header-back:hover{background:#fff;color:#131313;border-color:#cbd5e1}
    .dl-header-back svg{width:14px;height:14px}

    /* Modal (light) */
    .dl-modal{display:none;position:fixed;inset:0;background:rgba(15,23,42,.55);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);justify-content:center;align-items:center;z-index:9999;animation:fadeIn .25s ease-out;padding:20px}
    .dl-modal.open{display:flex}
    .dl-modal-content{background:#fff;border:1px solid #ededed;border-radius:14px;max-width:560px;width:100%;max-height:85vh;overflow-y:auto;box-shadow:0 12px 40px rgba(0,0,0,.10);animation:slideUp .3s ease-out}
    .dl-modal-head{padding:22px 28px 16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ededed}
    .dl-modal-title{font-size:18px;font-weight:700;color:#131313;margin:0}
    .dl-modal-close{width:32px;height:32px;border-radius:50%;background:#f6f6f6;border:none;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;color:#64748b;transition:.2s}
    .dl-modal-close:hover{background:#e2e8f0;color:#131313}
    .dl-modal-body{padding:22px 28px}
    .dl-tabs{display:flex;gap:4px;margin-bottom:20px;background:#f1f5f9;padding:4px;border-radius:10px;border:1px solid #ededed;overflow-x:auto}
    .dl-tab{flex:1;padding:9px 14px;font-size:13px;font-weight:500;text-align:center;cursor:pointer;border-radius:8px;transition:.2s;color:#64748b;white-space:nowrap}
    .dl-tab.active{background:#fff;color:#131313;box-shadow:0 1px 3px rgba(0,0,0,.08);font-weight:600}
    .dl-tab-content{display:none}
    .dl-tab-content.active{display:block;animation:fadeIn .25s ease-out}
    .dl-extbanner{width:100%;max-width:380px;height:auto;margin:0 auto 18px;display:block;border-radius:8px;border:1px solid #ededed}
    .dl-steps{list-style:none;counter-reset:s;padding:0;margin:0}
    .dl-steps li{counter-increment:s;padding:14px 0 14px 44px;position:relative;border-left:2px solid #ededed;margin-left:20px;color:#64748b;font-size:14px;line-height:1.55}
    .dl-steps li:last-child{border-left-color:transparent}
    .dl-steps li::before{content:counter(s);position:absolute;left:-19px;top:12px;width:36px;height:36px;background:#131313;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px}
    .dl-steps strong{color:#131313;font-weight:600}
    .dl-stepicon{height:18px;width:18px;vertical-align:middle;margin:0 3px}
    .dl-modal-foot{padding:16px 28px 22px}
    .dl-refresh{width:100%;padding:12px;font-size:14px;font-weight:600;color:#fff;background:#131313;border:none;border-radius:10px;cursor:pointer;transition:.2s}
    .dl-refresh:hover{background:#307df0}

    @keyframes fadeIn{from{opacity:0}to{opacity:1}}
    @keyframes fadeInUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
    @keyframes slideUp{from{transform:translateY(30px);opacity:0}to{transform:translateY(0);opacity:1}}
    .hidden{display:none !important}

    @media (max-width:760px){
      .dl-title{font-size:24px}
      .dl-row{padding:14px 16px;gap:10px;flex-wrap:wrap}
      .dl-meta{padding:4px 16px}
      .dl-meta-key{flex:0 0 100px;font-size:13px}
      .dl-meta-val{font-size:13px}
      .dl-btn{padding:8px 16px;font-size:13px}
    }
  </style>
</head>

