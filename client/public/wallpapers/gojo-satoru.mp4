  </div>

  <!-- Video tutorial modal -->
  <div class="dl-vmodal" id="dlVideoModal" role="dialog" aria-modal="true" aria-label="Video tutorial">
    <div class="dl-vmodal-box">
      <button class="dl-vmodal-close" type="button" id="dlVideoClose" aria-label="Close video">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="2.4" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <div class="dl-vmodal-frame">
        <iframe id="dlVideoIframe" src="" title="Wallsflow New Tab video tutorial" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
      </div>
    </div>
  </div>

  <!-- AdBlock modal -->
  <div class="dl-modal" id="dlModal" role="dialog" aria-modal="true" aria-labelledby="dlModalTitle">
    <div class="dl-modal-content">
      <div class="dl-modal-head">
        <h3 class="dl-modal-title" id="dlModalTitle">How to disable your ad blocker</h3>
        <button class="dl-modal-close" type="button" id="dlModalClose" aria-label="Close">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="dl-modal-body">
        <div class="dl-tabs" role="tablist">
          <div class="dl-tab active" data-target="adblock" role="tab" aria-selected="true">AdBlock</div>
          <div class="dl-tab" data-target="adblock-plus" role="tab" aria-selected="false">Adblock Plus</div>
          <div class="dl-tab" data-target="ublock-origin" role="tab" aria-selected="false">uBlock Origin</div>
          <div class="dl-tab" data-target="other" role="tab" aria-selected="false">Other</div>
        </div>

        <div id="adblock" class="dl-tab-content active">
          <img src="https://www.gstatic.com/fundingchoices/allowads/blockers/chrome/browser_ab-2.png" alt="AdBlock" class="dl-extbanner">
          <ol class="dl-steps">
            <li>Click the AdBlock icon <img src="https://www.gstatic.com/fundingchoices/allowads/blockers/chrome/ab_icon-1.svg" class="dl-stepicon" alt="AdBlock icon"> in your browser toolbar</li>
            <li>Select <strong>"Don't run on pages on this site"</strong></li>
            <li>Click <strong>"Exclude"</strong> in the dialog box</li>
          </ol>
        </div>

        <div id="adblock-plus" class="dl-tab-content">
          <img src="https://www.gstatic.com/fundingchoices/allowads/blockers/chrome/browser_abp-2.png" alt="Adblock Plus" class="dl-extbanner">
          <ol class="dl-steps">
            <li>Click the Adblock Plus icon <img src="https://www.gstatic.com/fundingchoices/allowads/blockers/chrome/abp_icon-1.svg" class="dl-stepicon" alt="Adblock Plus icon"> in your browser toolbar</li>
            <li>Click the <strong>power button</strong> <img src="https://www.gstatic.com/fundingchoices/allowads/blockers/chrome/abp_power_icon-1.svg" class="dl-stepicon" alt="Power icon"> to disable it</li>
            <li>Click <strong>Refresh</strong> to reload the page</li>
          </ol>
        </div>

        <div id="ublock-origin" class="dl-tab-content">
          <img src="https://www.gstatic.com/fundingchoices/allowads/blockers/chrome/browser_uo-2.png" alt="uBlock Origin" class="dl-extbanner">
          <ol class="dl-steps">
            <li>Click the uBlock Origin icon <img src="https://www.gstatic.com/fundingchoices/allowads/blockers/chrome/uo_icon-1.svg" class="dl-stepicon" alt="uBlock Origin icon"> in your browser toolbar</li>
            <li>Click the <strong>power button</strong> <img src="https://www.gstatic.com/fundingchoices/allowads/blockers/chrome/uo_power_icon-1.svg" class="dl-stepicon" alt="Power icon"> (it will turn gray)</li>
            <li>Click the <strong>refresh button</strong> <img src="https://www.gstatic.com/fundingchoices/allowads/blockers/chrome/uo_refresh_icon-1.svg" class="dl-stepicon" alt="Refresh icon"> to reload the page</li>
          </ol>
        </div>

        <div id="other" class="dl-tab-content">
          <ol class="dl-steps">
            <li>Find your ad blocker extension icon in the browser toolbar</li>
            <li>Click it and choose to <strong>disable the ad blocker for this site</strong></li>
            <li><strong>Refresh the page</strong> after disabling</li>
          </ol>
        </div>
      </div>
      <div class="dl-modal-foot">
        <button class="dl-refresh" type="button" onclick="location.reload()">Refresh page</button>
      </div>
    </div>
  </div>


  <script>
    // Multi-layer ad-block detection (handles AdBlock, uBlock Origin, AdGuard, Brave Shields, AdBlock Plus, Ghostery)
    const dlSleep = (ms)=>new Promise(r=>setTimeout(r,ms));

    async function dlDetectAdblock(){
      // --- Layer 1: Network probes (catches Brave Shields, uBlock Origin, pi-hole, AdGuard DNS) ---
      const adUrls = [
        'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js',
        'https://www.googletagservices.com/tag/js/gpt.js',
        'https://securepubads.g.doubleclick.net/tag/js/gpt.js'
      ];
      for(const url of adUrls){
        try{
          await fetch(url,{method:'HEAD',mode:'no-cors',cache:'no-store'});
        }catch(e){
          return true; // any blocked ad-network request = adblock present
        }
      }

      // --- Layer 2: DOM bait elements with multiple class signatures (catches CSS-rule blockers) ---
      const baitClasses = [
        'ads ad advert ad-banner adunit adsbox',
        'google-ads adsbygoogle ad-placeholder',
        'pub_300x250 pub_728x90 text-ad textAd',
        'ad-container ad-wrapper banner-ad adsense_wrapper'
      ];
      for(const cls of baitClasses){
        const bait = document.createElement('div');
        bait.className = cls;
        bait.innerHTML = '&nbsp;';
        bait.style.cssText = 'width:100px;height:100px;position:absolute;left:-9999px;top:-9999px;pointer-events:none;';
        document.body.appendChild(bait);
        await dlSleep(60);
        const cs = window.getComputedStyle(bait);
        const hidden =
          cs.display === 'none' ||
          cs.visibility === 'hidden' ||
          parseInt(cs.height,10) === 0 ||
          bait.offsetParent === null ||
          bait.offsetHeight === 0 ||
          bait.clientHeight === 0 ||
          bait.getBoundingClientRect().height === 0;
        bait.remove();
        if(hidden) return true;
      }

      // --- Layer 3: window.adsbygoogle stub check (some blockers replace the script) ---
      // We can't reliably check this because our own inline code creates the array.
      // Instead, we verify AdSense actually loaded its real implementation by checking the loaded property.
      if(typeof window.adsbygoogle === 'undefined' || window.adsbygoogle === null){
        return true;
      }

      // --- Layer 4: Wait for AdSense to render, then check ins status + dimensions ---
      await dlSleep(1500);
      const insList = document.querySelectorAll('ins.adsbygoogle');
      if(insList.length > 0){
        let anyFilled = false;
        let allUnfilledOrEmpty = true;
        insList.forEach(ins => {
          const status = ins.getAttribute('data-adsbygoogle-status');
          const rect = ins.getBoundingClientRect();
          const hasIframe = !!ins.querySelector('iframe');
          if(status === 'done' && (hasIframe || rect.height > 5)){
            anyFilled = true;
            allUnfilledOrEmpty = false;
          } else if(status === 'unfilled' || (!hasIframe && rect.height <= 1)){
            // unfilled or zero-height = likely blocked
          } else {
            allUnfilledOrEmpty = false; // still loading, give benefit of doubt
          }
        });
        if(allUnfilledOrEmpty && !anyFilled) return true;
      }

      return false;
    }

    // AdBlock detection toggle — set to true to re-enable
    const ADBLOCK_DETECT_ENABLED = false;

    let __dlAdblock = false;
    if (ADBLOCK_DETECT_ENABLED) {
      window.addEventListener('load', async () => {
        await dlSleep(400);
        __dlAdblock = await dlDetectAdblock();
      });
    }

    // Cooldown + Timer
    document.addEventListener("DOMContentLoaded",function(){
      const COOLDOWN_MS = 3 * 60 * 1000; // 3 minutes
      const downlinkRaw = 'index.php?do=download&id=1094&hash=12d84404f456d43eedb763cb3048eab9';
      const idMatch = downlinkRaw.match(/[?&]id=(\d+)/);
      const wpId = idMatch ? idMatch[1] : null;
      const STORAGE_KEY = wpId ? ('wf_dl_' + wpId) : null;

      const card=document.getElementById('dlCard');
      const cooldown=document.getElementById('dlCooldown');
      const cooldownLeft=document.getElementById('dlCooldownLeft');
      const adblockAlert=document.getElementById('dlAdblockAlert');
      const progress=document.getElementById('dlProgress');
      const eta=document.getElementById('dlEta');
      const btnDisabled=document.getElementById('dlBtnDisabled');
      const btnReady=document.getElementById('dlBtnReady');

      function fmt(sec){
        const m=Math.floor(sec/60);
        const s=sec%60;
        return m+':'+(s<10?'0':'')+s;
      }

      // 1) check cooldown
      let lastDl=0;
      try{ if(STORAGE_KEY) lastDl = parseInt(localStorage.getItem(STORAGE_KEY)||'0',10); }catch(e){}
      const elapsed = Date.now() - lastDl;
      if(lastDl && elapsed < COOLDOWN_MS){
        // Show cooldown UI, hide normal flow
        card.classList.add('hidden');
        cooldown.classList.remove('hidden');
        let remaining = Math.ceil((COOLDOWN_MS - elapsed)/1000);
        cooldownLeft.textContent = fmt(remaining);
        const cdTimer = setInterval(()=>{
          remaining--;
          if(remaining<=0){
            clearInterval(cdTimer);
            // Reload to start normal flow
            location.reload();
            return;
          }
          cooldownLeft.textContent = fmt(remaining);
        },1000);
        return;
      }

      // 2) normal countdown
      const TOTAL = parseInt('2',10) || 5;
      let timeout = TOTAL;
      let isPaused=false, timer;
      progress.style.width='0%';

      function tick(){
        if(isPaused) return;
        timeout--;
        const pct=((TOTAL-timeout)/TOTAL)*100;
        progress.style.width=Math.min(pct,100)+'%';
        if(timeout>0){
          eta.textContent='Ready in '+timeout+'s';
        }
        if(timeout<=0){
          clearInterval(timer);
          if(__dlAdblock){
            card.classList.add('hidden');
            adblockAlert.classList.remove('hidden');
          } else {
            btnDisabled.classList.add('hidden');
            btnReady.classList.remove('hidden');
            eta.textContent='Ready';
            eta.classList.add('ready');
          }
        }
      }
      eta.textContent='Ready in '+TOTAL+'s';
      timer=setInterval(tick,1000);
      document.addEventListener('visibilitychange',()=>{isPaused=document.hidden;});

      // 3) Save timestamp on click
      btnReady.addEventListener('click',()=>{
        try{ if(STORAGE_KEY) localStorage.setItem(STORAGE_KEY, Date.now().toString()); }catch(e){}
      });
    });

    // Modal + tabs
    const dlModal=document.getElementById('dlModal');
    const dlOpen=document.getElementById('dlOpenModal');
    const dlClose=document.getElementById('dlModalClose');
    const dlTabs=document.querySelectorAll('.dl-tab');
    const dlTabContents=document.querySelectorAll('.dl-tab-content');
    if(dlOpen){dlOpen.addEventListener('click',()=>dlModal.classList.add('open'));}
    if(dlClose){dlClose.addEventListener('click',()=>dlModal.classList.remove('open'));}
    dlModal.addEventListener('click',(e)=>{if(e.target===dlModal){dlModal.classList.remove('open');}});
    dlTabs.forEach(tab=>{
      tab.addEventListener('click',()=>{
        dlTabs.forEach(t=>{t.classList.remove('active');t.setAttribute('aria-selected','false');});
        dlTabContents.forEach(c=>c.classList.remove('active'));
        tab.classList.add('active');
        tab.setAttribute('aria-selected','true');
        document.getElementById(tab.dataset.target).classList.add('active');
      });
    });

    // Video tutorial modal
    (function(){
      const VIDEO_SRC = 'https://www.youtube-nocookie.com/embed/Lj0HiQw5cCY?autoplay=1&rel=0';
      const vModal=document.getElementById('dlVideoModal');
      const vOpen=document.getElementById('dlVideoOpen');
      const vClose=document.getElementById('dlVideoClose');
      const vFrame=document.getElementById('dlVideoIframe');
      function openVideo(){
        vFrame.src=VIDEO_SRC;
        vModal.classList.add('open');
        document.body.style.overflow='hidden';
      }
      function closeVideo(){
        vModal.classList.remove('open');
        vFrame.src='';
        document.body.style.overflow='';
      }
      if(vOpen) vOpen.addEventListener('click',openVideo);
      if(vClose) vClose.addEventListener('click',closeVideo);
      if(vModal) vModal.addEventListener('click',(e)=>{if(e.target===vModal) closeVideo();});
      document.addEventListener('keydown',(e)=>{if(e.key==='Escape'&&vModal.classList.contains('open')) closeVideo();});
    })();
  </script>
<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'a294c561dfa497fb',t:'MTc4NjQyNTQxNQ=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v4513226cdae34746b4dedf0b4dfa099e1781791509496" integrity="sha512-ZE9pZaUXND66v380QUtch/5sE9tPFh2zg45pR2PB0CVkCtOREv2AJKkSidISWkysEuQ0EH8faUU5du78bx87UQ==" data-cf-beacon='{"version":"2024.11.0","token":"1d11744efe4543ae84c0c0fa53f5bc23","r":1}' crossorigin="anonymous"></script>
